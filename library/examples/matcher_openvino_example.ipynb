   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# MatcherOpenVINO — one-shot segmentation on OpenVINO\\n\",\n",
    "    \"\\n\",\n",
    "    \"This notebook shows the new backend-agnostic contract for Matcher:\\n\",\n",
    "    \"\\n\",\n",
    "    \"1. Build a PyTorch `Matcher`.\\n\",\n",
    "    \"2. Convert it to OpenVINO IR **on the fly** with `MatcherOpenVINO.from_torch()`\\n\",\n",
    "    \"   (writes `encoder.xml` + `head.xml` to a temp dir; reference features are\\n\",\n",
    "    \"   *not* baked, so the exported model is reusable across `fit()` calls).\\n\",\n",
    "    \"3. `fit()` on a reference image + mask and `predict()` on a target.\\n\",\n",
    "    \"\\n\",\n",
    "    \"`fit()` / `predict()` take `Sample` objects and return `list[Prediction]` —\\n\",\n",
    "    \"identical to the PyTorch `Matcher`.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"from instantlearn.models import Matcher, MatcherOpenVINO\\n\",\n",
    "    \"from instantlearn.models.torch_base import ExportConfig\\n\",\n",
    "    \"from instantlearn.data.base.sample import Category, Sample\\n\",\n",
    "    \"from instantlearn.utils.constants import CompressionMode\\n\",\n",
    "    \"\\n\",\n",
    "    \"REF_IMAGE = \\\"assets/coco/000000286874.jpg\\\"\\n\",\n",
    "    \"REF_MASK = \\\"assets/coco/000000286874_mask.png\\\"\\n\",\n",
    "    \"TARGET_IMAGE = \\\"assets/coco/000000390341.jpg\\\"\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Convert a PyTorch Matcher to OpenVINO\\n\",\n",
    "    \"\\n\",\n",
    "    \"`from_torch()` does not require the model to be fitted. Export uses INT8 weight\\n\",\n",
    "    \"compression by default (INT4 is rejected for Matcher — it produces noisy masks).\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"torch_matcher = Matcher(device=\\\"cpu\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ov_model = MatcherOpenVINO.from_torch(\\n\",\n",
    "    \"    torch_matcher,\\n\",\n",
    "    \"    device=\\\"CPU\\\",\\n\",\n",
    "    \"    config=ExportConfig(compression=CompressionMode.INT8_SYM),\\n\",\n",
    "    \")\\n\",\n",
    "    \"print(\\\"Exported and loaded MatcherOpenVINO on\\\", ov_model.device)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Fit on a reference and predict on a target\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"ov_model.fit(\\n\",\n",
    "    \"    Sample(\\n\",\n",
    "    \"        image_path=REF_IMAGE,\\n\",\n",
    "    \"        mask_paths=[REF_MASK],\\n\",\n",
    "    \"        categories=[Category(0, \\\"elephant\\\")],\\n\",\n",
    "    \"    ),\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"predictions = ov_model.predict(Sample(image_path=TARGET_IMAGE))\\n\",\n",
    "    \"pred = predictions[0]\\n\",\n",
    "    \"print(\\\"masks :\\\", pred.masks.shape)\\n\",\n",
    "    \"print(\\\"scores:\\\", pred.scores)\\n\",\n",
    "    \"print(\\\"labels:\\\", pred.label_names)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Visualize\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import cv2\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"from instantlearn.visualizer import render_predictions, setup_colors\\n\",\n",
    "    \"\\n\",\n",
    "    \"target_rgb = cv2.cvtColor(cv2.imread(TARGET_IMAGE), cv2.COLOR_BGR2RGB)\\n\",\n",
    "    \"colors = setup_colors({0: \\\"elephant\\\"})\\n\",\n",
    "    \"# render_predictions accepts a Prediction directly.\\n\",\n",
    "    \"vis = render_predictions(target_rgb, pred, colors)\\n\",\n",
    "    \"plt.figure(figsize=(10, 8))\\n\",\n",
    "    \"plt.imshow(vis)\\n\",\n",
    "    \"plt.axis(\\\"off\\\")\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
