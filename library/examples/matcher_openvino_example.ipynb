   "metadata": {},
   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# MatcherOpenVINO — one-shot segmentation on OpenVINO\\n\",\n",
    "    \"\\n\",\n",
    "    \"This notebook shows the baked-IR contract for Matcher:\\n\",\n",
    "    \"\\n\",\n",
    "    \"1. Build a PyTorch `Matcher` and `fit()` it on a reference image + mask.\\n\",\n",
    "    \"2. Bake the reference features and post-processing into a single OpenVINO IR\\n\",\n",
    "    \"   with `Matcher.to_openvino()` (writes `matcher.xml` + `metadata.json`).\\n\",\n",
    "    \"3. Load the IR with `MatcherOpenVINO(model_dir=...)` and `predict()` on a target.\\n\",\n",
    "    \"\\n\",\n",
    "    \"Because the reference is baked into the graph at export time, the loaded\\n\",\n",
    "    \"`MatcherOpenVINO` does **not** support `fit()` — re-export to change references.\\n\",\n",
    "    \"`predict()` takes `Sample` objects and returns `list[Prediction]`.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"from instantlearn.models import Matcher, MatcherOpenVINO\\n\",\n",
    "    \"from instantlearn.models.torch_base import ExportConfig\\n\",\n",
    "    \"from instantlearn.data.base.sample import Category, Sample\\n\",\n",
    "    \"from instantlearn.utils.constants import CompressionMode\\n\",\n",
    "    \"\\n\",\n",
    "    \"REF_IMAGE = \\\"assets/coco/000000286874.jpg\\\"\\n\",\n",
    "    \"REF_MASK = \\\"assets/coco/000000286874_mask.png\\\"\\n\",\n",
    "    \"TARGET_IMAGE = \\\"assets/coco/000000390341.jpg\\\"\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Fit a PyTorch Matcher and bake it into an OpenVINO IR\\n\",\n",
    "    \"\\n\",\n",
    "    \"`to_openvino()` requires `fit()` first — the reference features are baked into\\n\",\n",
    "    \"the exported graph. Export uses INT8 weight compression by default (INT4 is\\n\",\n",
    "    \"rejected for Matcher — it produces noisy masks). Passing no path writes the IR\\n\",\n",
    "    \"to a temporary directory.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"torch_matcher = Matcher(device=\\\"cpu\\\")\\n\",\n",
    "    \"torch_matcher.fit(\\n\",\n",
    "    \"    Sample(\\n\",\n",
    "    \"        image_path=REF_IMAGE,\\n\",\n",
    "    \"        mask_paths=[REF_MASK],\\n\",\n",
    "    \"        categories=[Category(0, \\\"elephant\\\")],\\n\",\n",
    "    \"    ),\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ir_dir = torch_matcher.to_openvino(\\n\",\n",
    "    \"    config=ExportConfig(compression=CompressionMode.INT8_SYM),\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ov_model = MatcherOpenVINO(model_dir=ir_dir, device=\\\"CPU\\\")\\n\",\n",
    "    \"print(\\\"Exported and loaded MatcherOpenVINO on\\\", ov_model.device)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Predict on a target\\n\",\n",
    "    \"\\n\",\n",
    "    \"The reference is already baked into the IR, so no `fit()` is needed.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"predictions = ov_model.predict(Sample(image_path=TARGET_IMAGE))\\n\",\n",
    "    \"pred = predictions[0]\\n\",\n",
    "    \"print(\\\"masks :\\\", pred.masks.shape)\\n\",\n",
    "    \"print(\\\"scores:\\\", pred.scores)\\n\",\n",
    "    \"print(\\\"labels:\\\", pred.label_names)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Visualize\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import cv2\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"from instantlearn.visualizer import render_predictions, setup_colors\\n\",\n",
    "    \"\\n\",\n",
    "    \"target_rgb = cv2.cvtColor(cv2.imread(TARGET_IMAGE), cv2.COLOR_BGR2RGB)\\n\",\n",
    "    \"colors = setup_colors({0: \\\"elephant\\\"})\\n\",\n",
    "    \"# render_predictions accepts a Prediction directly.\\n\",\n",
    "    \"vis = render_predictions(target_rgb, pred, colors)\\n\",\n",
    "    \"plt.figure(figsize=(10, 8))\\n\",\n",
    "    \"plt.imshow(vis)\\n\",\n",
    "    \"plt.axis(\\\"off\\\")\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
