 "cells": [
  {
   "metadata": {},
   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"1a7e1d9b\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Post-Processing Demo\\n\",\n",
    "    \"\\n\",\n",
    "    \"Demonstrates how overlap-removal post-processors affect Matcher predictions.\\n\",\n",
    "    \"\\n\",\n",
    "    \"| # | Post-Processor | Key Parameter |\\n\",\n",
    "    \"|---|----------------|---------------|\\n\",\n",
    "    \"| 1 | BoxNMS | `iou_threshold=0.1` |\\n\",\n",
    "    \"| 2 | MaskIoMNMS | `iom_threshold=0.5` |\\n\",\n",
    "    \"| 3 | BoxIoMNMS | `iom_threshold=0.5` |\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"20f2539d\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Copyright (C) 2026 Intel Corporation\\n\",\n",
    "    \"# SPDX-License-Identifier: Apache-2.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"from __future__ import annotations\\n\",\n",
    "    \"\\n\",\n",
    "    \"import colorsys\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"\\n\",\n",
    "    \"from instantlearn.components.postprocessing import BoxIoMNMS, BoxNMS, MaskIoMNMS\\n\",\n",
    "    \"from instantlearn.data import Sample\\n\",\n",
    "    \"from instantlearn.data.utils.image import read_image\\n\",\n",
    "    \"from instantlearn.models import Matcher\\n\",\n",
    "    \"from instantlearn.visualizer import render_predictions\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"ccd2319e\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Helpers\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"36aa7596\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"EXAMPLES_DIR = Path(\\\"assets/coco\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def select_device() -> str:\\n\",\n",
    "    \"    \\\"\\\"\\\"Auto-select the best available device.\\\"\\\"\\\"\\n\",\n",
    "    \"    if hasattr(torch, \\\"xpu\\\") and torch.xpu.is_available():\\n\",\n",
    "    \"        return \\\"xpu\\\"\\n\",\n",
    "    \"    if torch.cuda.is_available():\\n\",\n",
    "    \"        return \\\"cuda\\\"\\n\",\n",
    "    \"    return \\\"cpu\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def instance_cmap(n: int) -> dict[int, list[int]]:\\n\",\n",
    "    \"    \\\"\\\"\\\"Generate a unique colour for each of *n* masks.\\\"\\\"\\\"\\n\",\n",
    "    \"    cmap: dict[int, list[int]] = {}\\n\",\n",
    "    \"    for i in range(n):\\n\",\n",
    "    \"        rgb = colorsys.hsv_to_rgb(i / max(n, 1), 0.9, 0.95)\\n\",\n",
    "    \"        cmap[i] = [int(c * 255) for c in rgb]\\n\",\n",
    "    \"    return cmap\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def show(\\n\",\n",
    "    \"    images: list[torch.Tensor],\\n\",\n",
    "    \"    predictions: list,\\n\",\n",
    "    \"    title: str,\\n\",\n",
    "    \") -> None:\\n\",\n",
    "    \"    \\\"\\\"\\\"Plot images with overlaid mask predictions and a count/score summary.\\\"\\\"\\\"\\n\",\n",
    "    \"    n = len(images)\\n\",\n",
    "    \"    fig, axes = plt.subplots(1, n, figsize=(7 * n, 7))\\n\",\n",
    "    \"    if n == 1:\\n\",\n",
    "    \"        axes = [axes]\\n\",\n",
    "    \"    for ax, img, pred in zip(axes, images, predictions, strict=False):\\n\",\n",
    "    \"        # Matcher.predict() returns Prediction objects; build a per-instance\\n\",\n",
    "    \"        # coloured render dict from its numpy fields.\\n\",\n",
    "    \"        n_masks = pred.masks.shape[0]\\n\",\n",
    "    \"        scores = torch.as_tensor(pred.scores)\\n\",\n",
    "    \"        pred_copy = {\\n\",\n",
    "    \"            \\\"pred_masks\\\": torch.as_tensor(pred.masks),\\n\",\n",
    "    \"            \\\"pred_scores\\\": scores,\\n\",\n",
    "    \"            \\\"pred_labels\\\": torch.arange(n_masks),\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"        cmap = instance_cmap(n_masks)\\n\",\n",
    "    \"        vis = render_predictions(img.permute(1, 2, 0).numpy(), pred_copy, cmap)\\n\",\n",
    "    \"        ax.imshow(vis)\\n\",\n",
    "    \"        ax.set_title(f\\\"{n_masks} masks  [{scores.min():.2f}, {scores.max():.2f}]\\\", fontsize=12)\\n\",\n",
    "    \"        ax.axis(\\\"off\\\")\\n\",\n",
    "    \"    fig.suptitle(title, fontsize=16, fontweight=\\\"bold\\\")\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"8575aa9f\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Load reference & targets\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"2c757c3a\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"device = select_device()\\n\",\n",
    "    \"\\n\",\n",
    "    \"ref_sample = Sample(\\n\",\n",
    "    \"    image_path=str(EXAMPLES_DIR / \\\"000000286874.jpg\\\"),\\n\",\n",
    "    \"    mask_paths=str(EXAMPLES_DIR / \\\"000000286874_mask.png\\\"),\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"target_paths = [\\n\",\n",
    "    \"    str(EXAMPLES_DIR / \\\"000000390341.jpg\\\"),\\n\",\n",
    "    \"    str(EXAMPLES_DIR / \\\"000000173279.jpg\\\"),\\n\",\n",
    "    \"    str(EXAMPLES_DIR / \\\"000000267704.jpg\\\"),\\n\",\n",
    "    \"]\\n\",\n",
    "    \"target_images = [read_image(p) for p in target_paths]\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"368eace3\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Original images\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"a0408d9e\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"model = Matcher(device=device, postprocessor=None)\\n\",\n",
    "    \"model.fit(ref_sample)\\n\",\n",
    "    \"raw = model.predict(target_paths)\\n\",\n",
    "    \"\\n\",\n",
    "    \"show(target_images, raw, \\\"Raw predictions (no post-processing)\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"4b497b34\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Raw predictions (no post-processing)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"2687ea0e\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"model = Matcher(device=device, postprocessor=None)\\n\",\n",
    "    \"model.fit(ref_sample)\\n\",\n",
    "    \"raw = model.predict(target_paths)\\n\",\n",
    "    \"\\n\",\n",
    "    \"show(target_images, raw, \\\"Raw predictions (no post-processing)\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"814cfd86\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. BoxNMS (IoU threshold = 0.1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Attach a `BoxNMS` post-processor to the model. Subsequent `predict()` calls\\n\",\n",
    "    \"automatically apply it — boxes with IoU > threshold are suppressed.\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"357fd6ef\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"model.postprocessor = BoxNMS(iou_threshold=0.1)\\n\",\n",
    "    \"results = model.predict(target_paths)\\n\",\n",
    "    \"\\n\",\n",
    "    \"show(target_images, results, \\\"BoxNMS (iou_threshold=0.1)\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"2a37828b\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. MaskIoMNMS (IoM threshold = 0.5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Replace the post-processor with `MaskIoMNMS`. The *smaller* mask is\\n\",\n",
    "    \"suppressed when the overlap (relative to its area) exceeds the threshold.\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"51b1dc51\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"model.postprocessor = MaskIoMNMS(iom_threshold=0.5)\\n\",\n",
    "    \"results = model.predict(target_paths)\\n\",\n",
    "    \"\\n\",\n",
    "    \"show(target_images, results, \\\"MaskIoMNMS (iom_threshold=0.5)\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"24d9a605\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. BoxIoMNMS (IoM threshold = 0.5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Same idea as `MaskIoMNMS` but computed on bounding boxes, which is\\n\",\n",
    "    \"faster for large mask counts.\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"854980bd\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"model.postprocessor = BoxIoMNMS(iom_threshold=0.5)\\n\",\n",
    "    \"results = model.predict(target_paths)\\n\",\n",
    "    \"\\n\",\n",
    "    \"show(target_images, results, \\\"BoxIoMNMS (iom_threshold=0.5)\\\")\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
